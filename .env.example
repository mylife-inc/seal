# CodeSeal local-stack environment.
#
# Copy this file → `.env`, then replace EVERY placeholder before running
# `docker compose up`. compose.yml's `env_file: .env` clauses load these
# directly; missing values produce empty strings which break Postgres
# initialization and authentication.
#
# A pre-flight `env-check` service runs before postgres/redis/portal-migrate
# and refuses to start the stack if:
#   - POSTGRES_PASSWORD or REDIS_PASSWORD contain URL-unsafe characters
#     (anything outside RFC 3986 unreserved: A-Z a-z 0-9 - . _ ~)
#   - any high-entropy secret is too short or still the placeholder.
#
# Generate URL-SAFE values:
#
#   openssl rand -hex 32                       # 64 hex chars — always URL-safe
#   openssl rand -base64 32 | tr '+/' '-_' \   # 43 base64url chars
#       | tr -d '='
#
# DO NOT use `openssl rand -base64 N` for passwords interpolated into
# connection URLs — base64's `+` and `/` are URL-unsafe and produce
# Prisma's notoriously opaque `P1013: invalid port number in database
# URL`. Use the hex or base64url forms above.
#
# .env is gitignored. Never commit it.

# ── Secrets — replace before `compose up` ─────────────────────────────
# Passwords below interpolate into postgres:// and redis:// URLs.
# MUST use only [A-Za-z0-9._~-] characters. `openssl rand -hex 32` is
# the safe default.
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# The three secrets below are not interpolated into URLs; any printable
# character is fine. Length minimums are enforced by env-check + the
# portal's session module:
#   SESSION_SECRET         ≥ 64 chars   (cookie HMAC key)
#   ENCRYPTION_PEPPER      ≥ 64 chars   (Argon2id pepper)
#   CODESEAL_WORKER_SECRET ≥ 32 chars   (worker ↔ portal HMAC)
SESSION_SECRET=change-me-64-char-random-secret
ENCRYPTION_PEPPER=change-me-64-char-random-pepper
CODESEAL_WORKER_SECRET=change-me-64-char-random-worker-secret

# ── Public URL — change if not running on localhost ───────────────────
CODESEAL_PUBLIC_URL=http://localhost:3000
# Session cookies are marked Secure automatically when this URL is https://.
# For local http://localhost deployments, leave SESSION_COOKIE_SECURE unset.
# SESSION_COOKIE_SECURE=false

# ── Host port mappings ────────────────────────────────────────────────
PORTAL_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── First-boot super-admin bootstrap (OPTIONAL) ───────────────────────
# If BOTH are set when the portal starts, a SUPER-ADMIN user is created
# automatically (per signup spec §4). Idempotent: subsequent boots
# confirm the role is super_admin and skip the password.
# REMOVE these once the user is created — leaving them in env state
# keeps a plaintext password sitting in the process environment.
# Password must be ≥ 12 chars or the portal refuses to start.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourorg.dev
# BOOTSTRAP_ADMIN_PASSWORD=pick-a-real-12-plus-char-password

# ── Signup mode (signup spec §2) ──────────────────────────────────────
# OPEN_SIGN_UP=true   anyone can create an account at /signup
# OPEN_SIGN_UP=false  (default) signup requires a valid invitation token
#                     issued by a super_admin via the admin UI.
OPEN_SIGN_UP=false

# HMAC secret used to hash invitation tokens. NEVER expose to the
# client. REQUIRED when OPEN_SIGN_UP=false (so invitation tokens can
# be hashed at creation + verified at submission).
# Generate with:  openssl rand -hex 32
INVITATION_TOKEN_SECRET=change-me-32-plus-char-random-secret

# Default TTL for new invitations. 168 hours = 7 days (spec §2.5).
# Super-admins can override per invitation in the create-invitation
# request body (`expiresInHours`).
DEFAULT_INVITATION_TTL_HOURS=168

# ── Logging + observability ───────────────────────────────────────────
LOG_LEVEL=info
# Leave unset to disable OpenTelemetry. Point to your collector to enable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── Build performance ─────────────────────────────────────────────────
# BuildKit Bake makes parallel image builds faster. Setting this once
# means `docker compose build` and `up --build` both use it.
COMPOSE_BAKE=true
DOCKER_BUILDKIT=1
